# Скопируйте в .env. Сервер читает .env сам, без зависимостей.
# Всё здесь необязательно: без .env программа просто работает.

# Порт и адрес. 0.0.0.0 — чтобы планшет достучался по сети.
PORT=4244
HOST=0.0.0.0

# Где держать книги. По умолчанию — library/ рядом с программой.
# LIBRARY_DIR=/Volumes/Books/полка

# Потолок на размер одного файла, МБ.
UPLOAD_LIMIT_MB=512

# Ключ нужен только для справки на полях (Значение / Перевод / Объяснить).
# Без него всё остальное работает как обычно.
# ANTHROPIC_API_KEY=sk-ant-...

# Какая модель отвечает на справку.
READER_MODEL=claude-opus-5
