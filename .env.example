# Copy to .env and fill in. The server reads .env at startup (no dependency needed).

# Required unless you run in HOLLOW mode (see below).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which model answers. Opus 5 is the default and the recommended one.
DIARY_MODEL=claude-opus-5

# Optional. Fast mode: same Opus 5 model, up to ~2.5x higher output tokens per
# second, at premium pricing ($10/$50 per MTok). Worth it here — the page starts
# filling sooner. Research preview; first-party Claude API only.
DIARY_FAST=0

# Optional. Ceiling on how long a single reply may run. The page is small and the
# hand is slow, so keep this tight; the persona is told to be brief regardless.
DIARY_MAX_TOKENS=400

# Optional. Port to listen on.
PORT=4243

# Optional. Bind address. 0.0.0.0 lets your iPad reach the machine over the LAN.
HOST=0.0.0.0

# Optional. Answer from a small canned repertoire instead of calling the API.
# Set to 1 to demo the whole experience without a key. Turns on automatically
# if no key is present, so the page is never dead.
DIARY_HOLLOW=0

# ---------------------------------------------------------------------------
# Lectern (the reader). Same key; separate knobs.
# ---------------------------------------------------------------------------

# Optional. Which model sets the type and answers word lookups.
LECTERN_MODEL=claude-opus-5

# Optional. Fast mode: the same Opus 5 model at up to ~2.5x the output rate, at
# premium pricing. A long article finishes noticeably sooner.
LECTERN_FAST=0

# Optional. The language words are translated into when you tap them. Any
# two-letter code; changeable per reader in the app's settings.
LECTERN_LANG=ru

# Optional. Port and bind address. 0.0.0.0 lets your phone reach it over Wi-Fi.
LECTERN_PORT=4244
LECTERN_HOST=0.0.0.0

# Optional. Where finished articles and translations are kept. A translated
# book is too big for a browser to hold, so it lives on disk instead.
LECTERN_LIBRARY=.lectern/library

# Optional. Skip the model: set type with the plain local typesetter and look
# words up through free public dictionaries. Translation is off in this mode.
# Turns on automatically when there is no key, so the app is never dead on
# arrival.
LECTERN_LOCAL=0
