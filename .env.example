# Copy to .env and fill in. The server reads .env at startup (no dependency needed).

# Required unless you run in HOLLOW mode (see below).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which model answers. Opus 5 is the default and the recommended one.
DIARY_MODEL=claude-opus-5

# Optional. Fast mode: same Opus 5 model, up to ~2.5x higher output tokens per
# second, at premium pricing ($10/$50 per MTok). Worth it here — the page starts
# filling sooner. Research preview; first-party Claude API only.
DIARY_FAST=0

# Optional. Ceiling on how long a single reply may run. The page is small and the
# hand is slow, so keep this tight; the persona is told to be brief regardless.
DIARY_MAX_TOKENS=400

# Optional. Port to listen on.
PORT=4243

# Optional. Bind address. 0.0.0.0 lets your iPad reach the machine over the LAN.
HOST=0.0.0.0

# Optional. Answer from a small canned repertoire instead of calling the API.
# Set to 1 to demo the whole experience without a key. Turns on automatically
# if no key is present, so the page is never dead.
DIARY_HOLLOW=0
