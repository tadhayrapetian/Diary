# Copy to .env and fill in. Without an account the app opens a demo mailbox.

# ── Your mailbox ────────────────────────────────────────────────
# The quick way: a known provider plus your address and an APP password
# (not your normal password — see README for where to get one).
# Providers: gmail, yandex, mailru, icloud, outlook, fastmail
# MAIL_PROVIDER=gmail
# MAIL_USER=you@gmail.com
# MAIL_PASS=abcdefghijklmnop

# How your name appears to people you write to.
# MAIL_FROM_NAME=Алекс Иванов

# Any other server: set the hosts yourself (these override the preset).
# IMAP_HOST=imap.example.org
# IMAP_PORT=993
# IMAP_SECURE=true
# SMTP_HOST=smtp.example.org
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=          # defaults to MAIL_USER
# SMTP_PASS=          # defaults to MAIL_PASS
# MAIL_FROM=          # sender address, defaults to MAIL_USER

# Force the demo mailbox even with an account filled in.
# MAIL_DEMO=1

# ── Server ──────────────────────────────────────────────────────
PORT=4280
# Only this computer can open it. Read the README before changing.
HOST=127.0.0.1
# ALLOWED_HOSTS=my-laptop.local   # extra host names the browser may use
