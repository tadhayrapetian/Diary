{
  "name": "aether-mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aether — a calm, fast, beautiful mail client for your own IMAP/SMTP account.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
